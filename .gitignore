# --- 1. 忽略虛擬環境與系統檔 (最重要) ---
Lib/
Scripts/
share/
Include/
pyvenv.cfg
__pycache__/
*.py[cod]

# --- 2. 忽略打包產生的垃圾 ---
build/
dist/

# --- 3. 忽略執行檔 (避免檔案過大) ---
*.exe

# --- 4. 忽略動態下載的核心二進位工具 (極為重要，避免大檔案上傳) ---
tools/

# --- 5. 忽略本地下載的測試影音檔與辨識產出檔 ---
*.mp4
*.webm
*.mp3
*_辨識結果.txt

# --- 6. 忽略開發工具設定 ---
.vscode/
.idea/